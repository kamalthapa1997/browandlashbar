# Required production configuration. Replace every placeholder outside Git.
NODE_ENV=production
PORT=5001
CLIENT_URL=https://merobrowandlashbar.com
MONGODB_URI=<production-mongodb-uri>
JWT_SECRET=<at-least-32-character-random-secret>

# Square Production — all required; never use Sandbox values here.
SQUARE_ENVIRONMENT=production
SQUARE_APPLICATION_ID=<square-production-application-id>
SQUARE_APPLICATION_SECRET=<square-production-application-secret>
SQUARE_LOCATION_ID=<square-production-location-id>
SQUARE_REDIRECT_URI=https://merobrowandlashbar.com/api/square/oauth/callback
SQUARE_TOKEN_ENCRYPTION_KEY=<32-byte-base64-aes-256-key>

# Cloudinary — all required for production uploads.
CLOUDINARY_CLOUD_NAME=<cloud-name>
CLOUDINARY_API_KEY=<api-key>
CLOUDINARY_API_SECRET=<api-secret>

# Google Places — all required for production reviews.
GOOGLE_PLACES_API_KEY=<api-key>
GOOGLE_PLACE_ID=<place-id>

# Optional operational setting.
SQUARE_TOKEN_REFRESH_WINDOW_MS=900000
